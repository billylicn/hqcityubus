{
  "name": "tongqin-bus-schedule",
  "version": "1.0.0",
  "private": true,
  "description": "澳门城市大学与横琴口岸通琴号班次静态查询站",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "data:generate": "node scripts/parse-routes.mjs",
    "data:check": "npm run data:generate",
    "predev": "npm run data:generate",
    "dev": "vite",
    "prebuild": "npm run data:generate",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run data:check && npm run typecheck && npm run lint && npm test && npm run build",
    "build:root": "npm run data:generate && VITE_BASE_PATH=/ VITE_OUT_DIR=dist vite build"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "8.0.13"
  }
}
